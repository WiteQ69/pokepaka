# Vercel: connect PostgreSQL (Neon) and a private Vercel Blob store.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Alternatively Blob can use BLOB_STORE_ID + VERCEL_OIDC_TOKEN automatically.

# Generate these server-only secrets: node scripts/create-admin-env.mjs
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Local Next.js preview only. Never enables temporary database writes on Vercel.
# POKEPAKA_LOCAL=1

# Cloudflare preview only; not used for authorization on Vercel.
# ADMIN_EMAIL_SHA256=
